# Copy to .env and replace every value. Docker Compose and the API read this file.
#
# The API checks these values when it starts. It does not start without JWT_SECRET and
# APP_SECRET. In production (Docker) it also refuses to start while JWT_SECRET, APP_SECRET,
# ADMIN_PASSWORD or MCP_PASSWORD still say "change-me", or while JWT_SECRET or APP_SECRET are
# shorter than 32 characters; its log names the one to fix.

# PostgreSQL password. Use only letters and digits: it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me

# Signs login tokens. Long random string, 32 characters or more: openssl rand -hex 32
JWT_SECRET=change-me

# How long a session lasts before its user logs in again: a whole number and s, m, h or d
# (seconds, minutes, hours, days). Optional; this is the value used without it. A session also
# ends when its user's password, role or active state changes.
#JWT_EXPIRES_IN=12h

# Encrypts the AI provider API keys stored in the database. Long random string, 32 characters or more.
# Changing it later makes the stored API keys unreadable; they must be entered again.
APP_SECRET=change-me

# First user, an administrator. Created on the first start, and again whenever no active
# administrator can log in (then that user becomes an administrator again; one that already has a
# password keeps it). ADMIN_PASSWORD must not stay as "change-me" even after that user exists:
# the start-up check looks at it every time.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador

# User for AI assistants that connect through the MCP server (folder mcp/). It is an agent: it
# works the cases and the catalogs, never the users or the settings, and every start makes it an
# agent again. Created at start when MCP_PASSWORD is set. Leave MCP_PASSWORD empty to disable it.
# MCP_USERNAME must not be ADMIN_USERNAME: the API refuses to start that way.
MCP_USERNAME=claude
MCP_NAME=Claude
MCP_PASSWORD=change-me

# Request limits. All three are optional; these are the values used without them. A request over a
# limit gets a 429 with a Retry-After header (seconds left).
# Failed logins per minute from one client address. The minute starts with the first login attempt
# from that address, right or wrong: past the limit, every login from it is refused until that minute
# is over, the right password too. Logins that work do not count. Besides, a username is locked for
# a minute after five failed attempts in a row (logins, or wrong current passwords when changing the
# own one), from wherever they come.
# With Docker Desktop (Windows, macOS) every client of the network reaches nginx from one internal
# address, so this limit is for the whole installation: any machine that spends it keeps everyone
# out of the login for that minute. Docker Engine on Linux, or an HTTPS proxy in front of the web
# with TRUST_PROXY_HOPS=2, gives the API the real address of each client.
#LOGIN_RATE_LIMIT=20
# Requests per minute to the whole API: of each user, for requests with a valid session; of each
# client address, for the others (logins among them, and requests with a forged or expired token).
# A token the API has stopped accepting but that has not expired (from before a change of password
# or role) has a count of its own, apart from the user's sessions that stand.
#API_RATE_LIMIT=1000
# Proxies in front of the API whose X-Forwarded-For header is believed, to know the address of
# each client: 1 is the nginx of the web container. Use 2 when another proxy (the one that adds
# HTTPS) sits in front of the web; otherwise every client would count as that proxy. With 2, only
# that proxy may reach the web port (for example WEB_PORT=127.0.0.1:4300 when it runs on the same
# machine): a client reaching the port directly could write any address in X-Forwarded-For.
#TRUST_PROXY_HOPS=1

# Port where the web app is published on the host.
WEB_PORT=4300

# Backups (service "backup"). All three are optional; these are the values used without them.
# Folder of this machine that receives the backups. Point it at a folder that is synced
# elsewhere (OneDrive, a network drive) to survive a damaged disk.
#BACKUP_DIR=./backups
# Days a database backup is kept.
#BACKUP_KEEP_DAYS=14
# Hours between two backups while the machine is on. One is always made at start-up.
#BACKUP_INTERVAL_HOURS=6

TZ=America/Guayaquil
