generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  UNRESOLVED
  PENDING
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  /// Null only on old rows: a user without a password cannot log in.
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  created     Ticket[]         @relation("TicketCreator")
  notes       TicketNote[]
  history     TicketHistory[]
  preferences UserPreference[]
}

/// People a case can be assigned to ("Responsable"). Managed from the UI. They are not users of
/// the app: a name is all a responsible has.
model Assignee {
  id        Int      @id @default(autoincrement())
  name      String
  /// False keeps the cases they have and takes them out of the lists for new ones.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// Client companies that report cases. Managed from the UI.
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  /// `searchKey(name)`: what the list of cases orders by when it orders by company. The database
  /// orders text by code point ("Óptica" and "acme" after "Zapatería"); this, the way people
  /// read the names ('Ñ' as 'n', since the accent goes). No default on purpose: a company created
  /// without it must not compile; a rename writes it next to the name.
  sortKey   String
  /// False keeps its cases and takes it out of the lists for new ones.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([sortKey])
}

/// "Tipos de soporte": labels a case can carry (a failure of the system, the user did not know
/// how...). Managed from the UI. A case has zero or more.
model SupportType {
  id        Int      @id @default(autoincrement())
  name      String
  /// "#rrggbb", lowercase.
  color     String   @db.VarChar(7)
  /// False keeps it on the cases that carry it and stops offering it for new ones.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets TicketSupportType[]
}

/// One support type of one case.
model TicketSupportType {
  ticketId      Int
  supportTypeId Int
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supportType   SupportType @relation(fields: [supportTypeId], references: [id], onDelete: Restrict)

  @@id([ticketId, supportTypeId])
  @@index([supportTypeId])
}

/// Catalog of the supported software's modules. Managed from the UI.
model SystemModule {
  id       Int            @id @default(autoincrement())
  name     String
  parentId Int?
  parent   SystemModule?  @relation("ModuleTree", fields: [parentId], references: [id], onDelete: SetNull)
  children SystemModule[] @relation("ModuleTree")
  active   Boolean        @default(true)
  tickets  Ticket[]
}

/// Hours allowed to resolve a ticket, per priority.
model SlaPolicy {
  priority Priority @id
  hours    Int
}

model Ticket {
  id               Int           @id @default(autoincrement())
  date             DateTime      @db.Date
  /// Time of day the client reported the problem, "HH:mm" as their clock showed it. Optional: many
  /// cases only have a day. Kept apart from `date`, which stays a calendar day with no time zone.
  time             String?       @db.VarChar(5)
  companyId        Int
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  description      String
  /// Name of the company and description in lowercase without accents. The search box matches
  /// against this. No default on purpose: a write that forgets it must not compile. See `ticketSearchKey`.
  searchText       String
  status           TicketStatus  @default(PENDING)
  assigneeId       Int?
  assignee         Assignee?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  priority         Priority?
  estimatedMinutes Int?
  spentMinutes     Int           @default(0)
  timerStartedAt   DateTime?
  moduleId         Int?
  module           SystemModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  dueAt            DateTime?
  /// "Promesa de entrega": day the team promised the client to have the case resolved. Null = no promise.
  promisedDate     DateTime?     @db.Date
  resolvedAt       DateTime?
  aiGenerated      Boolean       @default(false)
  /// Message for the person who asked for support. Drafted by the AI when the case is resolved; editable.
  customerReply    String?
  createdById      Int?
  createdBy        User?         @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  /// Last time a person worked on the case: created, edited, note or attachment added, client reply saved.
  /// Forgotten cases are measured from here. Only the writes that count as activity move it (see `activityStamp`).
  lastActivityAt   DateTime      @default(now())
  /// Last write of the row, whatever it was. Bookkeeping only: nothing reads it.
  updatedAt        DateTime      @updatedAt
  /// Moment the case was archived. Null = not archived: the lists show it.
  archivedAt       DateTime?

  notes        TicketNote[]
  attachments  Attachment[]
  history      TicketHistory[]
  supportTypes TicketSupportType[]

  @@index([status])
  @@index([date])
  @@index([companyId])
  @@index([assigneeId])
  @@index([promisedDate])
  @@index([archivedAt])
}

/// "Observación" entries. One ticket has many, each with date and author.
model TicketNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  text      String
  /// Text in lowercase without accents, for the search box. No default: see `noteSearchKey`.
  searchText String
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Attachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename   String
  storedName String
  mime       String
  size       Int
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

/// Small app-wide settings edited from Configuración, one row per key.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Small settings of the web that belong to one user (which columns of the case list to show...),
/// one row per user and key. Never shared between users: what is app-wide lives in `Setting`.
model UserPreference {
  userId    Int
  key       String
  /// The value, as JSON.
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// One row per AI provider. The API key is stored encrypted with APP_SECRET.
model AiProviderConfig {
  provider  String   @id
  apiKeyEnc String?
  baseUrl   String?
  model     String?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
