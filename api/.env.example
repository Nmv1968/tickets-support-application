# Development only: copy to api/.env. Used by `npm run start:dev` and by the Prisma CLI.
# Docker Compose does not read this file; it sets its own values from the .env of the project root.

# The development database started by `devdb/` (user, password and port are fixed there).
DATABASE_URL=postgresql://support:support@localhost:5433/support?schema=public

# Port of the API. The web development server forwards /api to it (web/proxy.conf.json).
PORT=3300

# Folder where attachments are stored.
UPLOAD_DIR=./uploads
